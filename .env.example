# Copy this file to .env for local testing, or set these as Environment
# Variables in your Render service settings for the real deployment.

# Required for real persistence (survives restarts/redeploys on Render).
# Get a free connection string from MongoDB Atlas — see README.md.
MONGODB_URI=

# Optional — database name inside your Atlas cluster. Defaults to symposium_quiz.
MONGODB_DB=symposium_quiz

# Optional — Render sets PORT automatically; only needed for local testing
# if you want a port other than 3000.
PORT=3000
